# Per-cluster SidLens settings. Copy to ~/.config/sidlens/site.env (or point
# SIDLENS_SITE_ENV at another file) on each cluster. scripts/common/_preamble.sh
# sources it at the start of every SLURM job; source it in your login shell too.
# Nothing here is read by Python directly -- these are ordinary env vars.

# Code checkout and bulk root on THIS cluster.
export SIDLENS_REPO=/path/to/sidlens
export SIDLENS_WORK=/path/to/bulk/sidlens

# Interpreter with `pip install -e "$SIDLENS_REPO[hub,test]"` done. Default is
# $SIDLENS_WORK/venv/bin/python; set this for conda or a module-provided python.
# export SIDLENS_PYTHON=/path/to/env/bin/python

# Which part of the substrate this cluster holds (core | ar | full). Unset means
# the whole snapshot must be present. Must match what `sidlens bundle pull` fetched.
export SIDLENS_VERIFY_PROFILE=ar

# Private HF dataset repos used by `sidlens bundle push/pull`.
# export SIDLENS_HF_REPO=<hf-user>/sidlens-substrate

# Site setup that must precede python (module systems, CUDA).
# module load cuda/12.4
